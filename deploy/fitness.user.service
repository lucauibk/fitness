[Unit]
Description=Fitness (Trainingsplan und Fortschritt)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/fitness
EnvironmentFile=%h/fitness/.env
ExecStart=%h/fitness/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
