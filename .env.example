# Zeitzone für Datumsgrenzen (Wochen, "heute")
TZ_NAME=Europe/Vienna

# Zusätzlich erlaubte Host-Namen, kommagetrennt. Tailscale-Namen, .local,
# nackte Rechnernamen und private IPs sind ohnehin erlaubt. "*" schaltet die Prüfung ab.
ALLOWED_HOSTS=

# Ablage der Datenbank (Standard: fitness.db neben dem Projekt)
# FITNESS_DB=/home/pi/fitness/fitness.db

# Optional: KI-Vertiefung im Plan-Check. Ohne Schlüssel gibt es nur den
# regelbasierten Check. Mit Schlüssel wird der Plan (Übungen, Sätze, Wdh.) auf
# Knopfdruck an die Anthropic-API geschickt.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: täglicher Coach (scripts/coach_daily.py, Timer fitness-coach.timer).
# Braucht Claude Code auf dem Pi; Token einmalig mit `claude setup-token` erzeugen.
# CLAUDE_CODE_OAUTH_TOKEN=
# COACH_MODEL=claude-sonnet-5-5
